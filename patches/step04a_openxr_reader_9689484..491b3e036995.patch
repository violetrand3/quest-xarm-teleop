+    // ---- Step 4A telemetry helpers -------------------------------------------------
+    static const char* qxStateName(XrSessionState s) {
+        switch (s) {
+            case XR_SESSION_STATE_IDLE: return "IDLE";
+            case XR_SESSION_STATE_READY: return "READY";
+            case XR_SESSION_STATE_SYNCHRONIZED: return "SYNCHRONIZED";
+            case XR_SESSION_STATE_VISIBLE: return "VISIBLE";
+            case XR_SESSION_STATE_FOCUSED: return "FOCUSED";
+            case XR_SESSION_STATE_STOPPING: return "STOPPING";
+            case XR_SESSION_STATE_LOSS_PENDING: return "LOSS_PENDING";
+            case XR_SESSION_STATE_EXITING: return "EXITING";
+            default: return "UNKNOWN";
+        }
+    }
+
+    void qxLog(const char* buf) {
+        __android_log_print(ANDROID_LOG_INFO, questxarm::kLogTag, "%s", buf);
+    }
+
+    void qxEmitEvent(const char* name, const char* state, int64_t timeNs, int poseValid,
+                     const XrPosef* previous) {
+        questxarm::Event e;
+        e.build = QUESTXARM_BUILD_ID;
+        e.session_id = qxSessionId_.c_str();
+        e.seq = ++qxSeq_;
+        e.name = name;
+        e.session_state = state;
+        e.time_ns = timeNs;
+        e.local_space_epoch = qxLocalEpoch_;
+        e.pose_valid = poseValid;
+        if (previous != nullptr) {
+            e.previous.p[0] = previous->position.x; e.previous.p[1] = previous->position.y;
+            e.previous.p[2] = previous->position.z;
+            e.previous.q[0] = previous->orientation.x; e.previous.q[1] = previous->orientation.y;
+            e.previous.q[2] = previous->orientation.z; e.previous.q[3] = previous->orientation.w;
+        }
+        char buf[questxarm::kMaxRecordBytes];
+        questxarm::format_event_record(e, buf, sizeof(buf));
+        qxLog(buf);
+    }
+
+    // Every event is seen here before the framework's own handling (XrApp::HandleXrEvents).
+    virtual void AppHandleEvent(XrEventDataBaseHeader* h) override {
+        switch (h->type) {
+            case XR_TYPE_EVENT_DATA_SESSION_STATE_CHANGED: {
+                auto* ev = reinterpret_cast<XrEventDataSessionStateChanged*>(h);
+                qxState_ = qxStateName(ev->state);
+                qxEmitEvent("session_state", qxState_, ev->time, -1, nullptr);
+            } break;
+            case XR_TYPE_EVENT_DATA_REFERENCE_SPACE_CHANGE_PENDING: {
+                auto* ev = reinterpret_cast<XrEventDataReferenceSpaceChangePending*>(h);
+                if (ev->referenceSpaceType == XR_REFERENCE_SPACE_TYPE_LOCAL) {
+                    // LOCAL origin changes at ev->changeTime; later code must not stitch
+                    // poses from different epochs into one trajectory.
+                    ++qxLocalEpoch_;
+                    qxLastLocalChange_ = ev->changeTime;
+                    qxEmitEvent("local_space_change_pending", "", ev->changeTime,
+                                ev->poseValid ? 1 : 0, ev->poseValid ? &ev->poseInPreviousSpace : nullptr);
+                } else {
+                    qxEmitEvent("other_space_change_pending", "", ev->changeTime, -1, nullptr);
+                }
+            } break;
+            case XR_TYPE_EVENT_DATA_EVENTS_LOST:
+                // Lost events may include space changes: consumers must treat this as a reset.
+                qxEmitEvent("events_lost", "", 0, -1, nullptr);
+                break;
+            case XR_TYPE_EVENT_DATA_INTERACTION_PROFILE_CHANGED:
+                qxEmitEvent("interaction_profile_changed", "", 0, -1, nullptr);
+                break;
+            default:
+                break;
+        }
+    }
+
+    questxarm::PoseSample qxLocate(XrSpace space, XrTime t, int actionActive) {
+        questxarm::PoseSample s;
+        s.action_active = actionActive;
+        XrSpaceLocation loc = {XR_TYPE_SPACE_LOCATION};
+        const XrResult r = xrLocateSpace(space, LocalSpace, t, &loc);  // explicitly LOCAL
+        s.queried = true;
+        s.result = static_cast<int32_t>(r);
+        if (XR_SUCCEEDED(r)) {
+            s.flags = static_cast<uint64_t>(loc.locationFlags);
+            s.p[0] = loc.pose.position.x; s.p[1] = loc.pose.position.y; s.p[2] = loc.pose.position.z;
+            s.q[0] = loc.pose.orientation.x; s.q[1] = loc.pose.orientation.y;
+            s.q[2] = loc.pose.orientation.z; s.q[3] = loc.pose.orientation.w;
+        }
+        return s;
+    }
+
+    questxarm::HandInputs qxInputs(XrPath hand, bool right) {
+        questxarm::HandInputs h;
+        auto f = [&](XrAction a) {
+            const auto st = GetActionStateFloat(a, hand);
+            return questxarm::FloatInput{st.isActive == XR_TRUE, st.currentState};
+        };
+        auto b = [&](XrAction a) {
+            const auto st = GetActionStateBoolean(a, hand);
+            return questxarm::BoolInput{st.isActive == XR_TRUE, st.currentState == XR_TRUE};
+        };
+        h.trigger = f(IndexTriggerAction);
+        h.squeeze = f(GripTriggerAction);
+        {
+            const auto st = GetActionStateVector2(JoystickAction, hand);
+            h.thumbstick = questxarm::Vec2Input{st.isActive == XR_TRUE, st.currentState.x, st.currentState.y};
+        }
+        h.thumbstick_click = b(thumbstickClickAction);
+        h.thumbstick_touch = b(ThumbStickTouchAction);
+        h.trigger_touch = b(TriggerTouchAction);
+        h.thumbrest_touch = b(ThumbRestTouchAction);
+        h.button_lower = b(right ? ButtonAAction : ButtonXAction);
+        h.button_upper = b(right ? ButtonBAction : ButtonYAction);
+        if (!right) {
+            h.menu = b(ButtonMenuAction);
+        }
+        return h;
+    }
+
+    void qxEmitPose(const OVRFW::ovrApplFrameIn& in) {
+        // One common query time for head and both grips: the frame's predicted display time
+        // (as passed through the framework, which stores it as double seconds).
