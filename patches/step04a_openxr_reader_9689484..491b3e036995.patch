index 0000000..df39c55
--- /dev/null
+++ b/app/src/QuestXarmTelemetry.h
@@ -0,0 +1,203 @@
+// QuestXarmPoseV1 diagnostic telemetry (Step 4A). DIAGNOSTIC ONLY: no robot control.
+//
+// This header has NO OpenXR dependency so it can be compiled and tested on a host.
+// main.cpp fills the plain structs below from real OpenXR calls and logs the
+// formatted JSON with logcat tag "QuestXarmPoseV1".
+//
+// Conventions (see docs/step04a_openxr_reader.md):
+//  * All poses are XrPosef values located in ONE reference space: XR_REFERENCE_SPACE_TYPE_LOCAL.
+//    "p" = position [x,y,z] in metres, "q" = orientation quaternion [x,y,z,w].
+//    The pose is T_local_from_X: it maps points expressed in frame X (grip or view)
+//    into LOCAL, i.e. p_local = R(q) * p_X + p   (column-vector convention).
+//  * OpenXR axes: right-handed, +X right, +Y up, -Z forward (for view/grip frames).
+//  * "p" is present only if XR_SPACE_LOCATION_POSITION_VALID_BIT is set; "q" only if
+//    ORIENTATION_VALID_BIT is set. The raw flags are always reported. No identity or
+//    previous-pose fallback is ever written.
+//  * t_query_ns is the XrTime passed to xrLocateSpace (the frame's predicted display
+//    time). It is a query/prediction time, NOT a sensor-capture time. Buttons come from
+//    xrSyncActions for the same frame and are not claimed to share that timestamp.
+
+#ifndef QUESTXARM_TELEMETRY_H
+#define QUESTXARM_TELEMETRY_H
+
+#include <cinttypes>
+#include <cmath>
+#include <cstdarg>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace questxarm {
+
+constexpr const char* kLogTag = "QuestXarmPoseV1";
+constexpr int kSchemaVersion = 1;
+constexpr size_t kMaxRecordBytes = 2048;  // well below the ~4 KB logcat payload limit
+
+// Bit values copied from the OpenXR specification (XrSpaceLocationFlagBits).
+constexpr uint64_t kOrientationValid = 0x00000001;
+constexpr uint64_t kPositionValid = 0x00000002;
+constexpr uint64_t kOrientationTracked = 0x00000004;
+constexpr uint64_t kPositionTracked = 0x00000008;
+
+struct PoseSample {
+    bool queried = false;      // xrLocateSpace was called
+    int32_t result = 0;        // XrResult of xrLocateSpace
+    int action_active = -1;    // pose-action isActive: 1/0, or -1 for the head (no action)
+    uint64_t flags = 0;        // raw XrSpaceLocationFlags
+    float p[3] = {0, 0, 0};
+    float q[4] = {0, 0, 0, 1};
+};
+
+struct FloatInput { bool active = false; float v = 0; };
+struct BoolInput { bool active = false; bool v = false; };
+struct Vec2Input { bool active = false; float x = 0, y = 0; };
+
+struct HandInputs {
+    FloatInput trigger, squeeze;
+    Vec2Input thumbstick;
+    BoolInput thumbstick_click, thumbstick_touch, trigger_touch, thumbrest_touch;
+    BoolInput button_lower, button_upper;  // right: A/B, left: X/Y
+    BoolInput menu;                         // left only
+};
+
+struct Frame {
+    const char* build = "";
+    const char* session_id = "";
+    uint64_t seq = 0;
+    int64_t t_query_ns = 0;
+    const char* session_state = "UNKNOWN";
+    bool focused = false;
+    uint32_t local_space_epoch = 0;        // number of LOCAL change-pending events received
+    int64_t last_local_change_time_ns = 0; // changeTime of the latest one (0 = none)
+    PoseSample head, grip_l, grip_r;
+    HandInputs in_l, in_r;
+};
+
+// Bounded appender: never writes past cap; remembers overflow.
+struct Out {
+    char* buf;
+    size_t cap;
+    size_t len = 0;
+    bool overflow = false;
+    Out(char* b, size_t c) : buf(b), cap(c) { if (cap) buf[0] = '\0'; }
+    void add(const char* fmt, ...) {
+        if (overflow) return;
+        va_list ap;
+        va_start(ap, fmt);
+        int n = vsnprintf(buf + len, cap - len, fmt, ap);
+        va_end(ap);
+        if (n < 0 || (size_t)n >= cap - len) { overflow = true; return; }
+        len += (size_t)n;
+    }
+};
+
+inline bool finite3(const float* v) { return std::isfinite(v[0]) && std::isfinite(v[1]) && std::isfinite(v[2]); }
+inline bool finite4(const float* v) { return finite3(v) && std::isfinite(v[3]); }
+
+inline void add_pose(Out& o, const char* key, const PoseSample& s) {
+    o.add("\"%s\":{", key);
+    o.add("\"queried\":%s,\"result\":%d", s.queried ? "true" : "false", (int)s.result);
+    if (s.action_active >= 0) o.add(",\"active\":%s", s.action_active ? "true" : "false");
+    const bool pv = (s.flags & kPositionValid) != 0, ov = (s.flags & kOrientationValid) != 0;
+    const bool pt = (s.flags & kPositionTracked) != 0, ot = (s.flags & kOrientationTracked) != 0;
+    o.add(",\"flags\":%" PRIu64 ",\"pos_valid\":%s,\"ori_valid\":%s,\"pos_tracked\":%s,\"ori_tracked\":%s",
+          s.flags, pv ? "true" : "false", ov ? "true" : "false", pt ? "true" : "false", ot ? "true" : "false");
+    const bool ok = s.queried && s.result >= 0;
+    // Non-finite values are never emitted as numbers; they are reported explicitly.
+    if (ok && pv && finite3(s.p)) o.add(",\"p\":[%.6f,%.6f,%.6f]", s.p[0], s.p[1], s.p[2]);
+    else o.add(",\"p\":null");
+    if (ok && ov && finite4(s.q)) o.add(",\"q\":[%.7f,%.7f,%.7f,%.7f]", s.q[0], s.q[1], s.q[2], s.q[3]);
+    else o.add(",\"q\":null");
+    if ((pv && !finite3(s.p)) || (ov && !finite4(s.q))) o.add(",\"nonfinite\":true");
+    o.add("}");
+}
+
+inline void add_f(Out& o, const char* k, const FloatInput& f) {
+    if (f.active && std::isfinite(f.v)) o.add("\"%s\":%.4f", k, f.v); else o.add("\"%s\":null", k);
+}
+inline void add_b(Out& o, const char* k, const BoolInput& b) {
+    if (b.active) o.add("\"%s\":%s", k, b.v ? "true" : "false"); else o.add("\"%s\":null", k);
+}
+inline void add_v2(Out& o, const char* k, const Vec2Input& v) {
+    if (v.active && std::isfinite(v.x) && std::isfinite(v.y)) o.add("\"%s\":[%.4f,%.4f]", k, v.x, v.y);
+    else o.add("\"%s\":null", k);
+}
+
+inline void add_hand(Out& o, const char* key, const HandInputs& h, bool right) {
+    o.add("\"%s\":{", key);
+    add_f(o, "trigger", h.trigger); o.add(",");
+    add_f(o, "squeeze", h.squeeze); o.add(",");
+    add_v2(o, "thumbstick", h.thumbstick); o.add(",");
+    add_b(o, "thumbstick_click", h.thumbstick_click); o.add(",");
+    add_b(o, "thumbstick_touch", h.thumbstick_touch); o.add(",");
+    add_b(o, "trigger_touch", h.trigger_touch); o.add(",");
+    add_b(o, "thumbrest_touch", h.thumbrest_touch); o.add(",");
+    add_b(o, right ? "a" : "x", h.button_lower); o.add(",");
+    add_b(o, right ? "b" : "y", h.button_upper);
+    if (!right) { o.add(","); add_b(o, "menu", h.menu); }
+    o.add("}");
+}
+
+// Returns the record length, or writes a small "overflow" record if the full one does not fit.
+inline size_t format_pose_record(const Frame& f, char* buf, size_t cap) {
+    Out o(buf, cap);
+    o.add("{\"v\":%d,\"type\":\"pose\",\"build\":\"%s\",\"sid\":\"%s\",\"seq\":%" PRIu64
+          ",\"space\":\"LOCAL\",\"t_query_ns\":%" PRId64 ",\"t_query_kind\":\"predicted_display_time\""
+          ",\"session_state\":\"%s\",\"focused\":%s,\"local_epoch\":%u,\"local_change_time_ns\":%" PRId64 ",",
+          kSchemaVersion, f.build, f.session_id, f.seq, f.t_query_ns, f.session_state,
+          f.focused ? "true" : "false", f.local_space_epoch, f.last_local_change_time_ns);
+    add_pose(o, "head", f.head); o.add(",");
+    add_pose(o, "grip_l", f.grip_l); o.add(",");
+    add_pose(o, "grip_r", f.grip_r); o.add(",");
+    add_hand(o, "in_l", f.in_l, false); o.add(",");
+    add_hand(o, "in_r", f.in_r, true);
+    o.add("}");
+    if (o.overflow) {
+        Out e(buf, cap);
+        e.add("{\"v\":%d,\"type\":\"overflow\",\"build\":\"%s\",\"sid\":\"%s\",\"seq\":%" PRIu64 "}",
+              kSchemaVersion, f.build, f.session_id, f.seq);
+        return e.len;
+    }
+    return o.len;
+}
+
+// Generic event record (session state changes, LOCAL space changes, session begin/end).
+struct Event {
+    const char* build = "";
+    const char* session_id = "";
+    uint64_t seq = 0;
+    const char* name = "";          // "session_begin", "session_state", "local_space_change_pending", "session_end"
+    const char* session_state = ""; // for session_state
+    int64_t time_ns = 0;            // XrTime from the event (changeTime for space changes); 0 if none
+    uint32_t local_space_epoch = 0;
+    int pose_valid = -1;            // space change: poseValid (1/0), -1 if not applicable
+    PoseSample previous;            // space change: poseInPreviousSpace (only if pose_valid==1)
+};
+
+inline size_t format_event_record(const Event& e, char* buf, size_t cap) {
+    Out o(buf, cap);
+    o.add("{\"v\":%d,\"type\":\"event\",\"build\":\"%s\",\"sid\":\"%s\",\"seq\":%" PRIu64
+          ",\"event\":\"%s\",\"space\":\"LOCAL\",\"local_epoch\":%u",
+          kSchemaVersion, e.build, e.session_id, e.seq, e.name, e.local_space_epoch);
+    if (e.session_state[0]) o.add(",\"session_state\":\"%s\"", e.session_state);
+    o.add(",\"time_ns\":%" PRId64, e.time_ns);
+    if (e.pose_valid >= 0) {
+        o.add(",\"pose_valid\":%s", e.pose_valid ? "true" : "false");
+        if (e.pose_valid && finite3(e.previous.p) && finite4(e.previous.q))
+            o.add(",\"pose_in_previous_space\":{\"p\":[%.6f,%.6f,%.6f],\"q\":[%.7f,%.7f,%.7f,%.7f]}",
+                  e.previous.p[0], e.previous.p[1], e.previous.p[2],
+                  e.previous.q[0], e.previous.q[1], e.previous.q[2], e.previous.q[3]);
+        else o.add(",\"pose_in_previous_space\":null");
+    }
+    o.add("}");
+    if (o.overflow) {
+        Out x(buf, cap);
+        x.add("{\"v\":%d,\"type\":\"overflow\",\"sid\":\"%s\",\"seq\":%" PRIu64 "}", kSchemaVersion, e.session_id, e.seq);
+        return x.len;
+    }
+    return o.len;
+}
+
+}  // namespace questxarm
+
+#endif  // QUESTXARM_TELEMETRY_H
